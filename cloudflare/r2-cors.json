{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "http://localhost:5173"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Content-Type", "Range"]
      },
      "exposeHeaders": ["Accept-Ranges", "Content-Length", "Content-Range", "ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}

# Optional overrides for nonstandard FFmpeg installations.
GOLDMINER_FFMPEG=ffmpeg
GOLDMINER_FFPROBE=ffprobe

# Required when no --transcript file is supplied. Never commit the real value.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_SCORING_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RERANK_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
